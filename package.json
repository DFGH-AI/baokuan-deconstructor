{
  "name": "baokuan-deconstructor",
  "version": "1.1.0",
  "private": true,
  "description": "爆款拆解官 · 整段文案自动清洗切段，浅色/深色双主题，拆成可复制的脚本公式",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
