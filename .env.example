# ── 选择模型厂商：qwen（通义千问）| kimi（Kimi）| mock（纯本地演示）
AI_PROVIDER=qwen

# 通义千问（阿里云百炼，OpenAI 兼容接口）
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
# 想启用真实模型时，取消下面这行注释并填入你的 Key：
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：默认 qwen-plus；想更便宜/更快可换 qwen-turbo
# AI_MODEL=qwen-plus

# Kimi（Moonshot AI 开放平台）
# 获取：https://platform.moonshot.cn/console/api-keys
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 默认 moonshot-v1-32k，足以容纳长文案；也可换账号可用的更新模型
# AI_MODEL=moonshot-v1-32k

# 通用覆盖项（可接任意 OpenAI 兼容服务，例如 OpenRouter 免费模型）
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-xxxxxxxx
# AI_MODEL=qwen/qwen3-8b:free

# 没有 API Key 时是否返回演示报告。上线正式使用后建议设为 false。
ALLOW_DEMO=true
